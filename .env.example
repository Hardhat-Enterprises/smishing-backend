#  Server Settings 
PORT=3000

#  MongoDB 
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smishingDB

#  JWT 
JWT_SECRET=your_jwt_secret_here

# Email (Gmail SMTP or other) 
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_LIMIT=5
OTP_LOCKOUT_TIME=600000   # in ms (10 minutes)

#  Dev Options 
EMAIL_DISABLED=true 
